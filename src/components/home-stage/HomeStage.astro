---
import HoloTile from '../holo/HoloTile.astro';
import HubProfile from '../hub/HubProfile.astro';
import TextBit from '../text-bit/TextBit.astro';
import { hubProfile } from '../../content/profile';
import { identity } from '../../content/identity';
import type { SectionModule } from '../../core/types';

interface Props {
  sections: SectionModule[];
}

const { sections } = Astro.props;
---

<main id="content" class="holo-home">
  <header class="holo-bar">
    <p class="holo-brand">
      <span class="sr-only">{identity.artistName}. {identity.personalName}.</span>
      <span aria-hidden="true">{identity.artistMark}</span>
    </p>
    <p class="holo-who">{identity.personalName}</p>
    <p class="holo-tag"><TextBit value={{ text: 'one-line tagline', placeholder: true }} /></p>
    <p class="holo-bar-code" aria-hidden="true">SIG // HOME</p>
  </header>

  <div class="holo-stage">
    <h1 class="sr-only">{identity.artistName}</h1>
    <HubProfile profile={hubProfile} />
    <div class="holo-menu">
    <nav class="holo-cluster" aria-label="Sections">
      {
        sections.map((section, index) => (
          <HoloTile
            grid
            href={section.route}
            size={section.tile.size}
            icon={section.tile.icon}
            code={section.tile.code}
            kana={section.kana}
            kanaLang={section.kanaLang}
            watermark={section.tile.watermark}
            style={`--col:${section.tile.col};--row:${section.tile.row};--cs:${section.tile.colSpan};--rs:${section.tile.rowSpan};--i:${index}`}
          >
            <span class="holo-copy">
              <span class="holo-title">{section.navLabel}</span>
              <span class="holo-sub">{section.tile.subtitle}</span>
            </span>
            <span class="holo-foot">
              {section.tile.statusPlaceholder ? (
                <TextBit value={{ text: section.tile.status, placeholder: true }} />
              ) : (
                <span>{section.tile.status}</span>
              )}
            </span>
          </HoloTile>
        ))
      }
    </nav>
    </div>
  </div>
</main>

<script>
  import { mountHoloParallax } from '../holo/holo-parallax';

  const stage = document.querySelector<HTMLElement>('.holo-stage');
  if (stage) mountHoloParallax(stage);
</script>
