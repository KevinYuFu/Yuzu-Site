---
/* Main Hub backdrop module (option B "HUD poster"). Self-contained: markup + hub-backdrop.css.
   Decorative only; sits behind .holo-home. */
import '../styles/hub-backdrop.css';
---
<div class="hb" aria-hidden="true">
  <div class="hb-grid"></div><div class="hb-aura"></div>
  <div class="hb-big hb-l">YUZU</div><div class="hb-big hb-r" lang="ja">ユズ</div>
  <div class="hb-slash hb-s1"></div><div class="hb-slash hb-s2"></div><div class="hb-slash hb-s3"></div>
  <svg class="hb-hud" viewBox="0 0 1440 900" preserveAspectRatio="none" fill="none">
    <g class="hb-br"><path d="M14 110V60h40M1426 110V60h-40M14 830v50h40M1426 830v50h-40"/></g>
    <g class="hb-rule"><path d="M70 880H560M880 880H1370M14 140V420M1426 480V800"/></g>
  </svg>
  <svg class="hb-ring hb-ring1" viewBox="-180 -180 360 360" fill="none"><circle r="120"/><circle r="86" stroke-dasharray="4 8"/><circle r="150" class="hb-faint"/><path d="M-170 0H-40M40 0H170M0-170V-40M0 40V170"/><circle r="4" class="hb-dot"/></svg>
  <svg class="hb-ring hb-ring2" viewBox="-120 -120 240 240" fill="none"><circle r="70"/><circle r="100" class="hb-faint" stroke-dasharray="2 6"/><path d="M-110 0H-20M20 0H110M0-110V-20M0 20V110"/></svg>
  <div class="hb-lbl hb-t3">YUZU.SYS // MAIN_HUB <span>· VER 2.6.10 — TOKYO/TORONTO</span></div>
  <div class="hb-barcode"></div>
  <div class="hb-vk" lang="ja">電脳音楽工房</div>
</div>
