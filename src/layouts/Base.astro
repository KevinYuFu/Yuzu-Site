---
import '../styles/global.css';
import HudFrame from '../components/HudFrame.astro';
import SignalField from '../components/SignalField.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yuzu — Yu Fu',
  description = 'Yu Fu (Yuzu): software, music production, mixing and mastering, teaching, and the Rivals event.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <SignalField />
    <div class="vignette" aria-hidden="true"></div>
    <HudFrame />
    <div class="scanlines" aria-hidden="true"></div>
    <a class="skip" href="#content">Skip to content</a>
    <SiteHeader />
    <slot />
    <script>
      import { mountReveal } from '../scripts/reveal';
      mountReveal();
    </script>
  </body>
</html>
