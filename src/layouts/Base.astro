---
import '../styles/theme.css';
import HudFrame from '../components/HudFrame.astro';
import Scanlines from '../components/Scanlines.astro';
import SignalField from '../components/SignalField.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import Vignette from '../components/Vignette.astro';
import { homeDescription, pageTitle } from '../content/identity';

interface Props {
  title?: string;
  description?: string;
  /** Home draws its own stage. Inner pages keep the HUD shell. */
  shell?: 'page' | 'home';
}

const {
  title = pageTitle(),
  description = homeDescription,
  shell = 'page',
} = Astro.props;
const home = shell === 'home';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class={home ? 'is-home' : undefined}>
    {!home && <SignalField />}
    {!home && <Vignette />}
    {!home && <HudFrame />}
    {!home && <Scanlines />}
    <SkipLink />
    {!home && <SiteHeader />}
    <slot />
    <script>
      import { mountReveal } from './reveal';
      mountReveal();
    </script>
  </body>
</html>
