---
/* Teacher module view: a landing page. Tiles are HoloTile faces. */
import HubBackdrop from '../../components/HubBackdrop.astro';
import GlitchTitle from '../../components/GlitchTitle.astro';
import HoloTile from '../../components/holo/HoloTile.astro';
import HeroMeta from '../../components/section/HeroMeta.astro';
import Pager from '../../components/section/Pager.astro';
import SectionPage from '../../components/section/SectionPage.astro';
import TextBit from '../../components/TextBit.astro';
import type { SectionViewProps } from '../../core/types';
import { teacher } from './teacher.data';
import './teacher.css';

const { section, prev, next } = Astro.props as SectionViewProps;
---
<HubBackdrop />
<SectionPage class="tl">
  <header class="hero tl-hero">
    <HeroMeta index={section.index} kana={section.kana} kanaLang={section.kanaLang} signal={section.signal} />
    <div class="hero-lockup">
      <p class="hero-kana" lang={section.kanaLang}>{section.kana}</p>
      <h1><span class="sr-only">{section.title}</span><GlitchTitle text={section.mark} /></h1>
    </div>
    <div class="tl-intro">
      <p class="tl-kicker"><span lang="ja">おしえかた</span> / Approach</p>
      <p class="tl-approach">{teacher.approach}</p>
    </div>
  </header>

  <section class="tl-block tl-classes" aria-labelledby="tl-classes">
    <p class="tl-kicker"><span lang="ja">クラス</span> / Classes</p>
    <h2 id="tl-classes" class="tl-h2">Choose a class</h2>
    <ul class="tl-grid">
      {teacher.tiles.map((t) => (
        <li class="tl-tile">
          <HoloTile href={`/teacher/${t.id}`} icon={t.icon} code={t.code} kana={t.kana}>
            <span class="holo-copy">
              <span class="holo-title" role="heading" aria-level="3">{t.title}</span>
              {t.fact && <span class="holo-sub tl-fact">{t.fact}</span>}
              <span class="holo-sub"><TextBit value={{ text: t.blurb, placeholder: true }} /></span>
            </span>
            <span class="holo-foot tl-foot">
              <span class="tl-view" aria-hidden="true">VIEW → <span lang="ja">詳細</span></span>
            </span>
          </HoloTile>
        </li>
      ))}
    </ul>
  </section>

  <Pager prev={prev} next={next} />
</SectionPage>
