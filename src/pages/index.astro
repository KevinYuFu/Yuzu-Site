---
import Base from '../layouts/Base.astro';
import HomeStage from '../components/HomeStage.astro';
import HubBackdrop from '../components/HubBackdrop.astro';
import { composeSite } from '../core/compose';
import { homeDescription, pageTitle } from '../core/identity';

const site = composeSite();
---

<Base
  shell="home"
  title={pageTitle()}
  description={homeDescription}
>
  <HubBackdrop />
  <HomeStage sections={site.sections} />
</Base>
