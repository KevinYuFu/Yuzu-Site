---
/* Teacher class detail. Generated from content.ts. */
import Base from '../../layouts/Base.astro';
import TeacherDetail from '../../modules/teacher/TeacherDetail.astro';
import { identity, pageTitle } from '../../content/identity';
import { teacher, type TeachTile } from '../../modules/teacher/content';

export function getStaticPaths() {
  return teacher.tiles.map((tile) => ({ params: { id: tile.id }, props: { tile } }));
}
interface Props { tile: TeachTile }
const { tile } = Astro.props;
---
<Base title={pageTitle(`${tile.title} — Teacher`)} description={`${tile.title} classes with ${identity.personalName}.`}>
  <TeacherDetail tile={tile} />
</Base>
