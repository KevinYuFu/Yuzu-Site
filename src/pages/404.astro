---
import Base from '../layouts/Base.astro';
import GlitchTitle from '../components/glitch-title/GlitchTitle.astro';
import HeroMeta from '../components/section/HeroMeta.astro';
import SectionPage from '../components/section/SectionPage.astro';
import TextLink from '../components/section/TextLink.astro';
import { identity, pageTitle } from '../content/identity';
---

<Base title={pageTitle('Signal lost')} description={`That page is not on the ${identity.artistName} site.`}>
  <SectionPage>
    <header class="hero">
      <HeroMeta index="404" kana="エラー" kanaLang="ja" signal="SIG.LOST // 0x9A00FF" />
      <h1>
        <span class="sr-only">Signal lost</span>
        <GlitchTitle text="LOST" />
      </h1>
      <p class="lede">That route is not registered.</p>
      <TextLink href="/">Return to {identity.artistName}</TextLink>
    </header>
  </SectionPage>
</Base>
