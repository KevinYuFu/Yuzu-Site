---
/* Project showcase stub. Real showcase content from Yu comes later; only name + dates from resume data here. */
import Base from '../../../layouts/Base.astro';
import HubBackdrop from '../../../components/hub-backdrop/HubBackdrop.astro';
import ProjectStub from '../../../modules/software/ProjectStub.astro';
import { pageTitle } from '../../../content/identity';
import { resume, type ResumeProject } from '../../../modules/software/content';

export function getStaticPaths() {
  return resume.projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: ResumeProject }
const { project } = Astro.props;
const n = resume.projects.indexOf(project) + 1;
---
<Base title={pageTitle(project.name)} description={`${project.name} project showcase (coming soon).`}>
  <HubBackdrop />
  <ProjectStub project={project} n={n} />
</Base>
